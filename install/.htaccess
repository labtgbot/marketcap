# TONBANKCARD installer is denied by default.
# During a controlled setup window, remove or relax this file, require
# TONBANKCARD_INSTALLER_TOKEN in the URL, then delete the install/ directory.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
